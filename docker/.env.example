#--------------------------------------------------------------------
# Container CI4 .env — REQUIRED on server (mounted read-only into vms-app)
#
#   cp .env docker/.env
#   then set the keys below
#
# MUST:
#   database.default.hostname = db          # NOT localhost (compose DNS)
#   database.default.password = SAME as DB_PASSWORD in docker/compose.env
#   app.baseURL = 'https://your-host/'      # no /vms/ path in container
#   CI_ENVIRONMENT = production
#   encryption.key = <keep from original .env>
#
# Tailscale Funnel example:
#   app.baseURL = 'https://vms-office.tailXXXX.ts.net/'
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

app.baseURL = 'https://YOUR_HOST/'
app.forceGlobalSecureRequests = false

database.default.hostname = db
database.default.database = vms
database.default.username = vms
database.default.password = CHANGE_ME_MATCH_COMPOSE_ENV
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci

# Keep encryption.key (and MAIL_*/LLM_* etc.) from your original .env
encryption.key =
