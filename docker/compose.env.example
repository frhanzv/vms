# Compose-only settings (ports / image / MySQL bootstrap).
# App settings live in docker/.env (real CI4 .env).
#
# MUST: DB_PASSWORD == database.default.password in docker/.env
# NOTE: Changing DB_PASSWORD later does NOT update an existing MySQL volume.
#       Fresh volume OR ALTER USER required after password change.
#
# Server: APP_PORT=80
# Windows local: APP_PORT=8081 (and match app.baseURL)

APP_PORT=80
DB_PORT=3307
PHPMYADMIN_PORT=8082

DB_DATABASE=vms
DB_USERNAME=vms
DB_PASSWORD=CHANGE_ME_MATCH_DOCKER_ENV
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

RUN_MIGRATIONS=true
RUN_SEEDERS=true

# Artifactory (Tailscale) / local image — bump when releasing
# VMS_IMAGE=bytespaceartifactory.tail61f14e.ts.net:8443/vms/vms:v.1.0.2
VMS_IMAGE=localhost/vms:v.1.0.2

# Old KVM CPUs without x86-64-v2 (keep this pin)
MYSQL_IMAGE=docker.io/library/mysql:8.0.37-oraclelinux8
